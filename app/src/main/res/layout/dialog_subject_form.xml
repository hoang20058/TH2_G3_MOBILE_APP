<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:clipToPadding="false"
    tools:theme="@style/SubjectFormDialogTheme">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp"
        android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageView android:layout_width="52dp" android:layout_height="52dp"
                android:padding="12dp" android:background="@drawable/subject_icon_pink_background"
                android:src="@drawable/subject_book" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvSubjectFormTitle" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                android:text="@string/subject_form_add" android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/subject_navy" />
        </LinearLayout>
        <TextView android:id="@+id/tvSubjectFormSubtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:text="@string/subject_form_add_subtitle" android:textSize="13sp"
            android:textColor="@color/subject_muted" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSubjectCode"
            style="@style/SubjectFormField" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/subject_form_code" app:helperText="@string/subject_form_code_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtDialogSubjectCode"
                style="@style/SubjectFormInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapCharacters" android:singleLine="true" android:imeOptions="actionNext"
                tools:text="PRM392" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSubjectName"
            style="@style/SubjectFormField" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:hint="@string/subject_form_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtDialogSubjectName"
                style="@style/SubjectFormInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:singleLine="true" android:imeOptions="actionNext"
                tools:text="Lập trình ứng dụng Android" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSubjectCredits"
            style="@style/SubjectFormField" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:hint="@string/subject_form_credits"
            app:helperText="@string/subject_form_credits_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtDialogCredits"
                style="@style/SubjectFormInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:singleLine="true" android:imeOptions="actionNext" tools:text="3" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSubjectDescription"
            style="@style/SubjectFormField" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:hint="@string/subject_description">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtDialogSubjectDesc"
                style="@style/SubjectFormInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minLines="3" android:gravity="top" android:inputType="textMultiLine|textCapSentences"
                tools:text="Nội dung và mục tiêu của môn học…" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/subject_form_required_note"
            android:textColor="@color/subject_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
