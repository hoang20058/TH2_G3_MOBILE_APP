<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcomeUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:text="Welcome User"
        android:textColor="@color/primary_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Cụm nút dành cho ADMIN (Người 2 & Người 3) -->
    <LinearLayout
        android:id="@+id/layoutAdminActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnManageStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="14dp"
            android:text="Student Management (Member 2)" />

        <Button
            android:id="@+id/btnManageSubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="14dp"
            android:text="Subject Management (Member 3)" />
    </LinearLayout>

    <!-- Cụm nút dành cho STUDENT (Người 4 & Người 5) -->
    <LinearLayout
        android:id="@+id/layoutStudentActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMySchedules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="14dp"
            android:text="My Study Schedules (Member 4)" />

        <Button
            android:id="@+id/btnBookSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="14dp"
            android:text="Book Study Session (Member 4)" />

        <Button
            android:id="@+id/btnCalendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="14dp"
            android:text="Calendar &amp; Notifications (Member 5)" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/status_cancelled"
        android:padding="12dp"
        android:text="LOGOUT" />

</LinearLayout>
