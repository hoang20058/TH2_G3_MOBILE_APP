<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/student_surface" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="68dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:background="#FFFFFF">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/student_ic_people" android:importantForAccessibility="no"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Sinh viên" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/student_navy" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/student_badge_bg" android:paddingHorizontal="10dp" android:paddingVertical="8dp" android:text="Quản trị viên" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/student_pink" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp" android:background="@drawable/student_search_bg" android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSearchStudent" android:layout_width="48dp" android:layout_height="match_parent" android:src="@drawable/student_ic_search" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Tìm sinh viên" android:padding="13dp"/>
        <EditText android:id="@+id/edtSearchStudent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingEnd="12dp" android:paddingStart="0dp" android:background="@null" android:hint="@string/student_search_hint" android:textColorHint="@color/student_muted" android:textColor="@color/student_navy" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="18dp" android:padding="16dp" android:background="@drawable/student_summary_bg" android:gravity="center_vertical">
        <ImageView android:layout_width="60dp" android:layout_height="60dp" android:layout_marginEnd="14dp" android:padding="14dp" android:background="@drawable/student_badge_bg" android:src="@drawable/student_ic_people" app:tint="@color/student_pink" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quản lý sinh viên" android:textColor="@color/student_navy" android:textSize="17sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/tvStudentCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Đang tải…" android:textColor="@color/student_navy" android:textSize="13sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddStudent" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="Thêm sinh viên" android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="@color/student_navy" app:cornerRadius="12dp" app:icon="@drawable/student_ic_plus" app:iconTint="#FFFFFF" app:iconGravity="textStart" app:iconSize="16dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="22dp" android:paddingTop="20dp" android:paddingBottom="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Danh sách sinh viên" android:textColor="@color/student_navy" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvStudentResults" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/student_muted" android:textSize="12sp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvStudents" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp" android:paddingBottom="12dp" android:clipToPadding="false"/>
        <TextView android:id="@+id/tvEmptyStudents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="28dp" android:gravity="center" android:visibility="gone" android:textColor="@color/student_muted" android:textSize="15sp" android:accessibilityLiveRegion="polite"/>
    </FrameLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/student_border"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:background="#FFFFFF" android:gravity="center" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
        <TextView android:id="@+id/btnStudentList" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/student_nav_active_bg" android:gravity="center" android:text="Sinh viên" android:textSize="11sp" android:textColor="@color/student_pink" android:drawableTop="@drawable/student_ic_people" android:drawableTint="@color/student_pink" android:paddingVertical="7dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/btnStudentQuickAdd" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Thêm mới" android:textSize="11sp" android:textColor="@color/student_muted" android:drawableTop="@drawable/student_ic_plus" android:drawableTint="@color/student_muted" android:paddingVertical="7dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/btnStudentRefresh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Làm mới" android:textSize="11sp" android:textColor="@color/student_muted" android:drawableTop="@drawable/student_ic_refresh" android:drawableTint="@color/student_muted" android:paddingVertical="7dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
